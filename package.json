{
  "name": "turing-mirror-page",
  "private": true,
  "version": "0.1.0",
  "description": "Static homepage for www.turingmirror.com deployed with Cloudflare Pages.",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public --ip 127.0.0.1 --port 4174",
    "check": "node --check public/site.js",
    "deploy": "wrangler pages deploy public --project-name turing-mirror-page"
  },
  "devDependencies": {
    "wrangler": "4.127.1"
  }
}
